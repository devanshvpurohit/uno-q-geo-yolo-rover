[Unit]
Description=Arduino UNO Q 4GB Geo-Aware YOLO Vision Rover
After=network.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/uno-q-geo-yolo-rover
ExecStart=/bin/bash /home/arduino/uno-q-geo-yolo-rover/run.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
